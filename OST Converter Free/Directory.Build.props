<Project>
  <!--
    Single place for the product identity and version of the app. The installer script
    (tools/release.ps1) reads these values.
  -->
  <PropertyGroup>
    <Version>1.0.0</Version>
    <Product>Webcent OST Converter Free</Product>
    <Company>Webcent Solutions</Company>
    <Copyright>Copyright (c) 2026 Webcent Solutions</Copyright>
    <Authors>Webcent Solutions</Authors>
  </PropertyGroup>
</Project>
