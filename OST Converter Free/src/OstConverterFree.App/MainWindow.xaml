<Window x:Class="OstConverter.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Webcent OST Converter Free" Width="1200" Height="780" MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen" AllowDrop="True" Drop="OnDrop" DragOver="OnDragOver">
    <Window.Resources>
        <!-- One step of the progress indicator: a numbered circle and a label, styled by StepState -->
        <DataTemplate x:Key="StepTemplate">
            <StackPanel Orientation="Horizontal" Margin="0,0,6,0">
                <Border x:Name="Dot" Width="24" Height="24" CornerRadius="12" BorderThickness="1.5" BorderBrush="#4D6F9C" Margin="0,0,8,0">
                    <TextBlock x:Name="Num" Text="{Binding Number}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="#9DB6D6"/>
                </Border>
                <TextBlock x:Name="Lbl" Text="{Binding Label}" VerticalAlignment="Center" Foreground="#9DB6D6"/>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding State}" Value="Active">
                    <Setter TargetName="Dot" Property="Background" Value="{StaticResource Accent}"/>
                    <Setter TargetName="Dot" Property="BorderBrush" Value="{StaticResource Accent}"/>
                    <Setter TargetName="Num" Property="Foreground" Value="White"/>
                    <Setter TargetName="Lbl" Property="Foreground" Value="White"/>
                    <Setter TargetName="Lbl" Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding State}" Value="Done">
                    <Setter TargetName="Dot" Property="BorderBrush" Value="{StaticResource Accent}"/>
                    <Setter TargetName="Num" Property="Foreground" Value="{StaticResource Accent}"/>
                    <Setter TargetName="Lbl" Property="Foreground" Value="White"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>
    <DockPanel>
        <!-- Brand bar -->
        <Border DockPanel.Dock="Top" Background="{StaticResource Navy}" Padding="22,0" Height="68">
            <DockPanel VerticalAlignment="Center">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border CornerRadius="11" Padding="11,3" Margin="0,0,10,0" VerticalAlignment="Center">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{StaticResource WarnSoft}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSignedOut}" Value="False">
                                        <Setter Property="Background" Value="{StaticResource GoodSoft}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="{Binding AccountBadge}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                    </Border>
                    <Button Content="{Binding UpdateText}" Command="{Binding InstallUpdateCommand}" Style="{StaticResource GhostButton}" Padding="12,5" Margin="0,0,10,0"
                            Visibility="{Binding UpdateReady, Converter={StaticResource BoolToVis}}"/>
                    <Button Content="Buy me a coffee" Command="{Binding BuyCoffeeCommand}" Style="{StaticResource GhostButton}" Padding="12,5" Margin="0,0,10,0"
                            ToolTip="Optional tip of about $10. The app stays free either way."
                            Visibility="{Binding HasCoffeeLink, Converter={StaticResource BoolToVis}}"/>
                    <Button Content="Account" Command="{Binding ShowAccountCommand}" Style="{StaticResource GhostButton}" Padding="14,5"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="pack://application:,,,/Assets/logo.png" Width="44" Height="44" RenderOptions.BitmapScalingMode="HighQuality" Margin="0,0,12,0"/>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,44,0">
                        <TextBlock Foreground="White" FontSize="17" LineHeight="20">
                            <Run Text="Webcent" FontWeight="Bold"/><Run Text=" OST Converter" FontWeight="Light"/><Run Text=" Free" FontWeight="SemiBold" Foreground="#F26BA8"/>
                        </TextBlock>
                        <TextBlock Text="Outlook data files, converted privately on this PC" Foreground="#8FB0D8" FontSize="11"/>
                    </StackPanel>
                    <ItemsControl x:Name="Steps" ItemTemplate="{StaticResource StepTemplate}" VerticalAlignment="Center">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </DockPanel>
        </Border>
        <!-- Accent line: the two logo colours -->
        <Border DockPanel.Dock="Top" Height="3">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#1A87E2" Offset="0"/>
                    <GradientStop Color="#E21A74" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>
        <!-- Footer -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="24,7">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" x:Name="VersionText" Foreground="{StaticResource TextMuted}" FontSize="11"/>
                <TextBlock Foreground="{StaticResource TextMuted}" FontSize="11"
                           Text="Your mail never leaves this computer. Files are opened read-only."/>
            </DockPanel>
        </Border>
        <ContentControl Content="{Binding CurrentPage}" Margin="24,20,24,16"/>
    </DockPanel>
</Window>
