<UserControl x:Class="OstConverter.App.Views.ConvertView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="720" HorizontalAlignment="Center" Margin="0,24,0,0">
            <Border Style="{StaticResource Card}" Padding="24">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="34" Height="34" CornerRadius="17" Background="{StaticResource GoodSoft}" Margin="0,0,12,0" VerticalAlignment="Center"
                                Visibility="{Binding Succeeded, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="&#x2713;" FontSize="18" FontWeight="Bold" Foreground="{StaticResource Good}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="{Binding Headline}" Style="{StaticResource Heading}" VerticalAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Margin="0,18,0,0" Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}">
                        <ProgressBar Value="{Binding Percent}" Maximum="100" Height="10"/>
                        <DockPanel Margin="0,8,0,0">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Status}" Style="{StaticResource Muted}"/>
                            <TextBlock Text="{Binding CurrentFolder}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
                        </DockPanel>
                        <Button Content="Cancel" Command="{Binding CancelCommand}" HorizontalAlignment="Left" Margin="0,18,0,0"/>
                    </StackPanel>

                    <StackPanel Margin="0,12,0,0" Visibility="{Binding IsDone, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="{Binding Details}" Style="{StaticResource Muted}"/>
                        <TextBlock Text="{Binding FatalError}" Foreground="{StaticResource Danger}" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Visibility="{Binding HasFatalError, Converter={StaticResource BoolToVis}}"/>

                        

                        <WrapPanel Margin="0,20,0,0">
                            <Button Content="Open output folder" Command="{Binding OpenFolderCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,10,8"/>
                            <Button Content="View log" Command="{Binding OpenLogCommand}" Margin="0,0,10,8"/>
                            <Button Content="Change options" Command="{Binding BackCommand}" Margin="0,0,10,8"/>
                            <Button Content="Convert another file" Command="{Binding NewFileCommand}" Margin="0,0,10,8"/>
                        </WrapPanel>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,14,0,0" Visibility="{Binding HasProblems, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="NEEDS ATTENTION" Style="{StaticResource SectionLabel}"/>
                    <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,8"
                               Text="These items were converted incompletely or skipped, usually because the file itself is missing their data. The full list is in the log."/>
                    <ItemsControl ItemsSource="{Binding Problems}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" FontSize="12" Margin="0,0,0,4"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
