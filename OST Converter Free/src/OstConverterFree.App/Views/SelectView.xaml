<UserControl x:Class="OstConverter.App.Views.SelectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="780" HorizontalAlignment="Center" Margin="0,8,0,0">
            <Image Source="pack://application:,,,/Assets/logo.png" Width="96" Height="96" HorizontalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality"/>
            <TextBlock Text="Convert an Outlook data file" Style="{StaticResource Heading}" FontSize="28" HorizontalAlignment="Center" Margin="0,8,0,0"/>
            <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,16" TextAlignment="Center" MaxWidth="620"
                       Text="Open an OST or PST file, choose the folders you want, and save them as PST, EML, MSG, MBOX, PDF, HTML or CSV. Your file is only read, never changed, and nothing leaves this computer."/>
            <ItemsControl HorizontalAlignment="Center" Margin="0,0,0,14">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><WrapPanel HorizontalAlignment="Center"/></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.Items>
                    <Border Style="{StaticResource Chip}"><TextBlock Text="PST" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Accent}"/></Border>
                    <Border Style="{StaticResource Chip}"><TextBlock Text="EML" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Accent}"/></Border>
                    <Border Style="{StaticResource Chip}"><TextBlock Text="MSG" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Accent}"/></Border>
                    <Border Style="{StaticResource Chip}"><TextBlock Text="MBOX" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Accent}"/></Border>
                    <Border Style="{StaticResource Chip}"><TextBlock Text="PDF" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Accent}"/></Border>
                    <Border Style="{StaticResource Chip}"><TextBlock Text="HTML" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Accent}"/></Border>
                    <Border Style="{StaticResource Chip}"><TextBlock Text="CSV" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Accent}"/></Border>
                </ItemsControl.Items>
            </ItemsControl>

            <Border Style="{StaticResource Card}" Padding="0">
                <Border BorderThickness="1.5" CornerRadius="10" Margin="14" Padding="24,34" Background="{StaticResource AccentSoft}">
                    <Border.BorderBrush>
                        <DrawingBrush Viewport="0,0,8,8" ViewportUnits="Absolute" TileMode="Tile">
                            <DrawingBrush.Drawing>
                                <GeometryDrawing Brush="{StaticResource Accent}">
                                    <GeometryDrawing.Geometry>
                                        <GeometryGroup>
                                            <RectangleGeometry Rect="0,0,4,1"/>
                                            <RectangleGeometry Rect="0,4,1,4"/>
                                        </GeometryGroup>
                                    </GeometryDrawing.Geometry>
                                </GeometryDrawing>
                            </DrawingBrush.Drawing>
                        </DrawingBrush>
                    </Border.BorderBrush>
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Text="Drop an .ost or .pst file here" FontSize="17" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                        <TextBlock Text="or" Style="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,6"/>
                        <Button Content="Browse for a file…" Command="{Binding BrowseCommand}" Style="{StaticResource PrimaryButton}" Padding="22,9"
                                HorizontalAlignment="Center" IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBool}}"/>
                        <TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,12,0,0"
                                   Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                        <ProgressBar IsIndeterminate="True" Height="4" Width="240" Margin="0,8,0,0"
                                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </Border>
            </Border>

            <Border Style="{StaticResource Card}" Background="{StaticResource DangerSoft}" BorderBrush="{StaticResource Danger}" Margin="0,14,0,0"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding Error}" Foreground="{StaticResource Danger}" TextWrapping="Wrap"/>
            </Border>

            <StackPanel Margin="0,26,0,12" Visibility="{Binding HasDetected, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="FOUND ON THIS PC" Style="{StaticResource SectionLabel}"/>
                <ItemsControl ItemsSource="{Binding Detected}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Card}" Padding="14,10" Margin="0,0,0,8">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Open"
                                            Command="{Binding DataContext.OpenDetectedCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"/>
                                    <Border DockPanel.Dock="Left" Background="{StaticResource AccentSoft}" CornerRadius="5" Padding="8,3" Margin="0,0,12,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Kind}" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Accent}"/>
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding SizeText}" Style="{StaticResource Muted}" FontSize="12"/>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0"
                           Text="Outlook keeps these files open while it runs. If a file won't open, close Outlook or copy the file first."/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
