<UserControl x:Class="OstConverter.App.Views.OptionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="290" MinWidth="220"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="*" MinWidth="320"/>
            <ColumnDefinition Width="12"/>
            <ColumnDefinition Width="300"/>
        </Grid.ColumnDefinitions>

        <!-- Folders -->
        <Border Grid.Column="0" Style="{StaticResource Card}" Padding="12">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="All" Command="{Binding SelectAllCommand}" Style="{StaticResource LinkButton}" Margin="0,0,10,0"/>
                        <Button Content="None" Command="{Binding SelectNoneCommand}" Style="{StaticResource LinkButton}"/>
                    </StackPanel>
                    <TextBlock Text="FOLDERS" Style="{StaticResource SectionLabel}" Margin="0"/>
                </DockPanel>
                <CheckBox DockPanel.Dock="Bottom" Content="Show hidden system folders" IsChecked="{Binding IncludeSystemFolders}" Margin="0,10,0,0"
                          Foreground="{StaticResource TextMuted}"/>
                <Grid>
                    <TreeView x:Name="Tree" ItemsSource="{Binding Roots}" BorderThickness="0" Background="Transparent"
                              SelectedItemChanged="OnFolderSelected"
                              VirtualizingPanel.IsVirtualizing="True">
                        <TreeView.ItemContainerStyle>
                            <Style TargetType="TreeViewItem">
                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}"/>
                                <Setter Property="IsSelected" Value="{Binding IsSelected, Mode=TwoWay}"/>
                                <Setter Property="Padding" Value="0,2"/>
                            </Style>
                        </TreeView.ItemContainerStyle>
                        <TreeView.ItemTemplate>
                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                <StackPanel Orientation="Horizontal">
                                    <CheckBox IsChecked="{Binding IsChecked, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                                </StackPanel>
                            </HierarchicalDataTemplate>
                        </TreeView.ItemTemplate>
                    </TreeView>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding IsLoadingTree, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Reading folders…" Style="{StaticResource Muted}"/>
                        <ProgressBar IsIndeterminate="True" Height="4" Width="140" Margin="0,8,0,0"/>
                    </StackPanel>
                    <TextBlock Text="{Binding TreeError}" Foreground="{StaticResource Danger}" TextWrapping="Wrap" VerticalAlignment="Top"/>
                </Grid>
            </DockPanel>
        </Border>

        <!-- Items + preview -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="120"/>
                <RowDefinition Height="8"/>
                <RowDefinition Height="1.2*" MinHeight="120"/>
            </Grid.RowDefinitions>
            <Border Style="{StaticResource Card}" Padding="0">
                <Grid>
                    <DataGrid ItemsSource="{Binding Items}" SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                              AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="{StaticResource Line}" BorderThickness="0" Background="Transparent"
                              RowBackground="Transparent" SelectionMode="Single" CanUserAddRows="False" RowHeight="26">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date" Binding="{Binding Date}" Width="130"/>
                            <DataGridTextColumn Header="From" Binding="{Binding From}" Width="170"/>
                            <DataGridTextColumn Header="Subject" Binding="{Binding Subject}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock Text="Select a folder to see its items." Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock.Visibility>
                            <MultiBinding Converter="{StaticResource EmptyHint}">
                                <Binding Path="SelectedFolder"/>
                                <Binding Path="IsLoadingItems"/>
                            </MultiBinding>
                        </TextBlock.Visibility>
                    </TextBlock>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding IsLoadingItems, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Loading items…" Style="{StaticResource Muted}"/>
                        <ProgressBar IsIndeterminate="True" Height="4" Width="140" Margin="0,8,0,0"/>
                    </StackPanel>
                    <TextBlock Text="{Binding ItemsNote}" Style="{StaticResource Muted}" FontSize="12" VerticalAlignment="Bottom" Margin="10,0,0,4"/>
                </Grid>
            </Border>
            <GridSplitter Grid.Row="1" Height="8" HorizontalAlignment="Stretch" Background="Transparent"/>
            <Border Grid.Row="2" Style="{StaticResource Card}" Padding="14">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="{Binding PreviewHeader}" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <TextBox Text="{Binding PreviewBody, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                             BorderThickness="0" Padding="0" Background="Transparent"/>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Export settings -->
        <Border Grid.Column="4" Style="{StaticResource Card}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                    <Border Background="{StaticResource WarnSoft}" CornerRadius="6" Padding="10,8" Margin="0,0,0,10"
                            Visibility="{Binding IsSignedOut, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="Previewing is free. Sign in with your email to convert; the account is free and has no limits."
                                       Foreground="{StaticResource Warn}" TextWrapping="Wrap" FontSize="12"/>
                            <Button Content="Create account / sign in" Command="{Binding SignInCommand}" Style="{StaticResource PrimaryButton}"
                                    HorizontalAlignment="Left" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Text="{Binding Summary}" Style="{StaticResource Muted}" Margin="0,0,0,10"/>
                    <Button Content="Convert" Command="{Binding ConvertCommand}" IsEnabled="{Binding CanConvert}"
                            Style="{StaticResource PrimaryButton}" Padding="14,10" FontSize="14"/>
                </StackPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="FILE" Style="{StaticResource SectionLabel}"/>
                        <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding FileName}"/>
                        <DockPanel Margin="0,2,0,16">
                            <Button DockPanel.Dock="Right" Content="Change" Command="{Binding ChooseAnotherFileCommand}" Style="{StaticResource LinkButton}"/>
                            <TextBlock Text="{Binding FileInfoText}" Style="{StaticResource Muted}" FontSize="12"/>
                        </DockPanel>

                        <TextBlock Text="CONVERT TO" Style="{StaticResource SectionLabel}"/>
                        <ComboBox ItemsSource="{Binding Formats}" SelectedItem="{Binding SelectedFormat}" DisplayMemberPath="Label"/>
                        <TextBlock Text="{Binding SelectedFormat.Hint}" Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,16"/>

                        <StackPanel Visibility="{Binding ShowSplit, Converter={StaticResource BoolToVis}}" Margin="0,0,0,16">
                            <TextBlock Text="SPLIT INTO FILES OF" Style="{StaticResource SectionLabel}"/>
                            <ComboBox ItemsSource="{Binding SplitSizes}" SelectedItem="{Binding SelectedSplit}" DisplayMemberPath="Label"/>
                            <TextBlock Text="Outlook handles data files up to 50 GB. A larger mailbox is saved as several PST files, each a complete data file you can open on its own." Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"/>
                        </StackPanel>

                        <DockPanel Margin="0,0,0,6">
                            <Button DockPanel.Dock="Right" Content="Clear" Command="{Binding ClearDatesCommand}" Style="{StaticResource LinkButton}"/>
                            <TextBlock Text="DATE RANGE (OPTIONAL)" Style="{StaticResource SectionLabel}" Margin="0"/>
                        </DockPanel>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="8"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <DatePicker SelectedDate="{Binding DateFrom}" ToolTip="From"/>
                            <DatePicker Grid.Column="2" SelectedDate="{Binding DateTo}" ToolTip="To"/>
                        </Grid>

                        <TextBlock Text="SAVE TO" Style="{StaticResource SectionLabel}"/>
                        <TextBox Text="{Binding OutputFolder, UpdateSourceTrigger=PropertyChanged}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                        <Button Content="Choose folder…" Command="{Binding BrowseOutputCommand}" HorizontalAlignment="Left"/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
