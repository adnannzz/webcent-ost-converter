<Window x:Class="OstConverter.App.AccountWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Account" Width="500" Height="560" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="CanResize">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="26,22,26,22">
            <TextBlock Text="Your account" Style="{StaticResource Heading}"/>

            <!-- Status -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <TextBlock FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Text" Value="{Binding AccountEmail}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSignedIn}" Value="False">
                                        <Setter Property="Text" Value="Not signed in"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding StatusText}" Style="{StaticResource Muted}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                    <WrapPanel Margin="0,14,0,0" Visibility="{Binding IsSignedIn, Converter={StaticResource BoolToVis}}">
                        <Button Content="Sign out" Command="{Binding SignOutCommand}" IsEnabled="{Binding IsBusy, Converter={StaticResource InvertBool}}"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- Create account / sign in -->
            <Border Style="{StaticResource Card}" Margin="0,12,0,0" Visibility="{Binding IsSignedOut, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="CREATE ACCOUNT OR SIGN IN" Style="{StaticResource SectionLabel}"/>
                    <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,10" TextWrapping="Wrap"
                               Text="Enter your email address. We'll email you a 6-digit code, so there is no password to remember. The first time you sign in, your free account is created."/>
                    <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,4" Text="Your name (shown only to the app owner, for support)"/>
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="100" Margin="0,0,0,10" ToolTip="Your name"/>
                    <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,0,0,4" Text="Email address"/>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Send code" Command="{Binding SendCodeCommand}" IsEnabled="{Binding CanSendCode}" Margin="8,0,0,0"/>
                        <TextBox Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" ToolTip="Email address"/>
                    </DockPanel>
                    <DockPanel Margin="0,10,0,0" Visibility="{Binding CodeSent, Converter={StaticResource BoolToVis}}">
                        <Button DockPanel.Dock="Right" Content="Sign in" Command="{Binding SignInCommand}" IsEnabled="{Binding CanSignIn}"
                                Style="{StaticResource PrimaryButton}" Margin="8,0,0,0"/>
                        <TextBox Text="{Binding Code, UpdateSourceTrigger=PropertyChanged}" MaxLength="12" ToolTip="6-digit code"/>
                    </DockPanel>

                    <StackPanel Margin="0,14,0,0" Visibility="{Binding NeedsDeviceChoice, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="SIGN OUT ONE OF THESE PCS" Style="{StaticResource SectionLabel}"/>
                        <ItemsControl ItemsSource="{Binding LimitDevices}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,0,0,6">
                                        <Button DockPanel.Dock="Right" Content="Sign out and use this PC instead"
                                                Command="{Binding DataContext.ReplaceDeviceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"/>
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Devices -->
            <Border Style="{StaticResource Card}" Margin="0,12,0,0" Visibility="{Binding IsSignedIn, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="YOUR PCS" Style="{StaticResource SectionLabel}"/>
                    <ItemsControl ItemsSource="{Binding Devices}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <DockPanel Margin="0,0,0,6">
                                    <Button DockPanel.Dock="Right" Content="Sign out" Padding="10,3"
                                            Visibility="{Binding CanRemove, Converter={StaticResource BoolToVis}}"
                                            Command="{Binding DataContext.RemoveDeviceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"/>
                                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                </DockPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Style="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"
                               Text="One account can be signed in on up to 2 PCs."/>
                </StackPanel>
            </Border>

            <!-- Messages -->
            <Border Margin="0,12,0,0" CornerRadius="6" Padding="12,9" Visibility="{Binding HasMessage, Converter={StaticResource BoolToVis}}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{StaticResource AccentSoft}"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding MessageIsError}" Value="True">
                                <Setter Property="Background" Value="{StaticResource DangerSoft}"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap"/>
            </Border>

            <ProgressBar IsIndeterminate="True" Height="3" Margin="0,10,0,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}"/>

            <Button Content="Close" Click="OnClose" HorizontalAlignment="Right" Margin="0,16,0,0" IsCancel="True"/>
        </StackPanel>
    </ScrollViewer>
</Window>
