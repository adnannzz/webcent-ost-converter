<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <!-- The conversion engine (OstConverter.Core) lives in the sibling "OST Converter" folder. -->
    <ProjectReference Include="..\..\..\OST Converter\src\OstConverter.Core\OstConverter.Core.csproj" />
    <ProjectReference Include="..\OstConverterFree.Accounts\OstConverterFree.Accounts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\logo.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <StartupObject>OstConverter.App.Program</StartupObject>
    <AssemblyName>WebcentOstConverterFree</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <AssemblyTitle>Webcent OST Converter Free</AssemblyTitle>
    <Description>Webcent OST Converter Free: convert Outlook OST and PST files to PST, EML, MSG, MBOX, PDF, HTML and CSV with a free account</Description>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

</Project>
